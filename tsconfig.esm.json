{
    "extends": "./tsconfig.base",
    "compilerOptions": {
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "target": "ES2017",
        "module": "ESNext",
        "outDir": "./build_bundles/esm",
        "declarationDir": "./build_bundles/esm",
        "emitDeclarationOnly": true
    },
    "include": ["src/**/*.ts"]
}
